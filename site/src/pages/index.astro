---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero';
import Pick from '../components/Pick';
import Install from '../components/Install.astro';
import Api from '../components/Api.astro';
---
<Base title="peekons: icons that peek out of your buttons" description="Icons with a face that peek out of buttons, cards and text, make a gesture and hide again. React, Astro or plain HTML.">
  <TopBar />
  <Rail />
  <main>
    <Hero client:load />
    <Pick client:visible />
    <Install />
    <Api />
  </main>
  <script>
    import '../scripts/page';
  </script>
</Base>
