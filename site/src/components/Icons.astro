---
import * as icons from 'peekons/icons';
const all = Object.values(icons);
---
<section id="icons" class="mx-auto max-w-6xl px-5 py-24">
  <h2 class="text-4xl font-bold tracking-tight">Icons</h2>
  <p class="mt-3 max-w-xl text-muted">{all.length} mascots, each its own file, so your bundle only carries the ones you import. Click one to copy its import.</p>
  <ul class="mt-10 grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-5 lg:grid-cols-9">
    {all.map((icon) => (
      <li class="bg-bg">
        <button
          data-peekon={icon.name}
          data-copy={`import { ${icon.name} } from 'peekons/icons';`}
          class="flex h-24 w-full flex-col items-center justify-end gap-1 pb-4 text-sm hover:bg-surface"
        >
          <span>{icon.name}</span>
          <span class="text-[11px] text-muted" data-copy-label>{icon.gesture}</span>
        </button>
      </li>
    ))}
  </ul>
</section>
