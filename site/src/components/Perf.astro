<section id="performance" class="mx-auto max-w-6xl px-5 py-24">
  <h2 class="text-4xl font-bold tracking-tight">A hundred at once</h2>
  <p class="mt-3 max-w-xl text-muted">
    A resting mascot is one empty span. Its drawing exists only while it moves and is removed when it
    hides, so a page full of them costs almost nothing. Try it.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-6">
    <button id="perf-toggle" class="inline-flex h-10 items-center rounded-full bg-fg px-5 text-sm font-medium text-bg">Show 100 mascots</button>
    <dl class="flex gap-8 text-sm">
      <div><dt class="text-muted">Drawn right now</dt><dd id="perf-drawn" class="text-2xl font-semibold tabular-nums">0</dd></div>
      <div><dt class="text-muted">Animations running</dt><dd id="perf-anims" class="text-2xl font-semibold tabular-nums">0</dd></div>
    </dl>
  </div>
  <div id="perf-grid" class="mt-10 grid grid-cols-4 gap-x-2 gap-y-9 sm:grid-cols-8 lg:grid-cols-10"></div>
</section>
<script>
  import { mount } from 'peekons';
  import * as icons from 'peekons/icons';

  const grid = document.getElementById('perf-grid')!;
  const toggle = document.getElementById('perf-toggle')!;
  const drawn = document.getElementById('perf-drawn')!;
  const anims = document.getElementById('perf-anims')!;
  const all = Object.values(icons);
  let off: (() => void) | undefined;
  let raf = 0;

  // los contadores corren solo mientras hay mascotas en la grilla
  const count = () => {
    drawn.textContent = String(grid.querySelectorAll('.pk svg').length);
    anims.textContent = String(grid.getAnimations({ subtree: true }).length);
    raf = off ? requestAnimationFrame(count) : 0;
  };

  toggle.addEventListener('click', () => {
    if (off) {
      off();
      off = undefined;
      grid.replaceChildren();
      toggle.textContent = 'Show 100 mascots';
      return count();
    }
    grid.replaceChildren(
      ...Array.from({ length: 100 }, (_, i) => {
        const b = document.createElement('button');
        const icon = all[i % all.length]!;
        b.dataset.peekon = icon.name;
        b.textContent = icon.name;
        b.className = 'h-8 truncate rounded-md border border-line px-2 text-xs hover:bg-surface';
        return b;
      })
    );
    off = mount(icons, { root: grid });
    toggle.textContent = 'Remove them';
    if (!raf) count();
  });
</script>
