{
  "name": "peekons",
  "version": "0.1.0",
  "description": "Icons with a face that peek out of buttons, boxes and text on hover, make a gesture and hide again.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "peekons.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./sound": {
      "types": "./dist/sound.d.ts",
      "default": "./dist/sound.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./peekons.css": "./peekons.css"
  },
  "keywords": [
    "icons",
    "svg",
    "animation",
    "hover",
    "react",
    "astro",
    "mascot"
  ],
  "scripts": {
    "icons": "tsx scripts/build-icons.ts",
    "build": "npm run icons && rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite playground",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
